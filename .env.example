# FixEasy Frontend Environment Variables (from previous deployment)
# Copy this file to `.env.local` and replace placeholder values where noted.

# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://wphmhlrttmzsmngysfws.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_KEY=replace-with-your-supabase-anon-key

# Backend API configuration
NEXT_PUBLIC_API_URL=https://api.fixeasy.irish
NEXT_PUBLIC_SITE_URL=https://fixeasy.irish

# Runtime configuration
NEXT_PUBLIC_ENV=production
NODE_VERSION=18

# Admin tooling (keep secret in Vercel, not required locally unless testing admin APIs)
ADMIN_SECRET=replace-with-admin-secret
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_SECRET=replace-with-jwt-secret
